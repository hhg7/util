# Makemaker generated files and build artifacts
^Makefile$
^Makefile\.old$
^blib/
^pm_to_blib$
^blibdirs$
^MYMETA\.
^MANIFEST\.bak$

# Release archives and unpacked distribution directories
^Cn-Util-.*\.tar\.gz$
^Cn-Util-[\d\.]+/?$

# The compatibility shim for "use Util" and the code retired from it
^Util\.pm$
^old\.util\.pm$

# Scratch files for the author's scripts
^donate\.file\.txt$
^receiving\.file\.txt$

# Local development and helper scripts (Ignores all .pl EXCEPT Makefile.PL)
^(?!Makefile\.PL$).*\.pl$
^dzil\.sh$
^compile\.sh$
^CLAUDE\.md$
^\.claude/

# Version control (Standard best practice)
^\.git/
^\.gitignore$
